diff --git a/src/core/ngx_symlink_access.c b/src/core/ngx_symlink_access.c
new file mode 100644
index 0000000..cc232a6
--- /dev/null
+++ b/src/core/ngx_symlink_access.c
@@ -0,0 +1,158 @@
+/* Symlink target access policy. SPDX-License-Identifier: BSD-2-Clause */
+#include <ngx_config.h>
+#include <ngx_core.h>
+#include <ngx_symlink_access.h>
+
+typedef struct {
+    ngx_pool_t        *pool;
+    ngx_sa_id_t        user;
+    ngx_sa_id_t       *groups;
+    ngx_uint_t         n;
+    ngx_int_t          status;
+    time_t             created;
+} ngx_sa_entry_t;
+
+struct ngx_sa_cache_s {
+    ngx_sa_entry_t   **slots;
+    ngx_uint_t         max;
+    time_t             valid;
+    time_t             negative_valid;
+};
+
+ngx_int_t
+ngx_sa_id_copy(ngx_pool_t *pool, ngx_sa_id_t *id, const void *data, size_t len)
+{
+    id->data = ngx_palloc(pool, len);
+    if (id->data == NULL) {
+        return NGX_ERROR;
+    }
+    ngx_memcpy(id->data, data, len);
+    id->len = len;
+    return NGX_OK;
+}
+
+ngx_int_t
+ngx_sa_id_equal(const ngx_sa_id_t *a, const ngx_sa_id_t *b)
+{
+    return a->len == b->len && a->len != 0
+           && ngx_memcmp(a->data, b->data, a->len) == 0;
+}
+
+static void
+ngx_sa_cleanup(void *data)
+{
+    ngx_sa_cache_t *cache = data;
+    ngx_uint_t i;
+    for (i = 0; i < cache->max; i++) {
+        if (cache->slots[i]) { ngx_destroy_pool(cache->slots[i]->pool); }
+    }
+}
+
+ngx_sa_cache_t *
+ngx_sa_cache_create(ngx_pool_t *pool, ngx_uint_t max, time_t valid,
+    time_t negative_valid)
+{
+    ngx_sa_cache_t     *cache;
+    ngx_pool_cleanup_t *cln;
+    cache = ngx_pcalloc(pool, sizeof(ngx_sa_cache_t));
+    cln = ngx_pool_cleanup_add(pool, 0);
+    if (cache == NULL || cln == NULL) { return NULL; }
+    cache->slots = ngx_pcalloc(pool, (max ? max : 1) * sizeof(ngx_sa_entry_t *));
+    if (cache->slots == NULL) { return NULL; }
+    cache->max = max;
+    cache->valid = valid;
+    cache->negative_valid = negative_valid;
+    cln->handler = ngx_sa_cleanup;
+    cln->data = cache;
+    return cache;
+}
+
+static ngx_int_t
+ngx_sa_groups(ngx_symlink_access_t *ctx, ngx_sa_id_t *user,
+    ngx_sa_id_t **groups, ngx_uint_t *n)
+{
+    ngx_sa_cache_t    *cache;
+    ngx_sa_entry_t    *entry;
+    ngx_pool_t       *pool;
+    ngx_uint_t        slot;
+    time_t            now, ttl;
+
+    cache = ctx->cache;
+    if (cache == NULL || cache->max == 0) {
+        return ngx_sa_get_user_groups(ctx->pool, user, groups, n);
+    }
+    now = ngx_time();
+    slot = ngx_crc32_short(user->data, user->len) % cache->max;
+    entry = cache->slots[slot];
+    if (entry && ngx_sa_id_equal(user, &entry->user)) {
+        ttl = entry->status == NGX_OK ? cache->valid : cache->negative_valid;
+        if (now >= entry->created && now - entry->created < ttl) {
+            *groups = entry->groups;
+            *n = entry->n;
+            return entry->status;
+        }
+    }
+    /* A collision evicts, never authorizes: always compare the complete ID. */
+    if (entry) { ngx_destroy_pool(entry->pool); cache->slots[slot] = NULL; }
+    pool = ngx_create_pool(4096, ctx->pool->log);
+    if (pool == NULL) { return NGX_ERROR; }
+    entry = ngx_pcalloc(pool, sizeof(ngx_sa_entry_t));
+    if (entry == NULL || ngx_sa_id_copy(pool, &entry->user, user->data,
+                                      user->len) != NGX_OK)
+    {
+        ngx_destroy_pool(pool);
+        return NGX_ERROR;
+    }
+    entry->pool = pool;
+    entry->status = ngx_sa_get_user_groups(pool, user, &entry->groups, &entry->n);
+    /* Timestamp before lookup: a slow lookup must not extend stale membership. */
+    entry->created = now;
+    cache->slots[slot] = entry;
+    *groups = entry->groups;
+    *n = entry->n;
+    return entry->status;
+}
+
+ngx_int_t
+ngx_sa_check(ngx_symlink_access_t *ctx, ngx_fd_t fd)
+{
+    ngx_fd_t        root;
+    ngx_sa_access_t base, target;
+    ngx_sa_id_t    *groups;
+    ngx_uint_t      n, i, j, bits;
+    ngx_flag_t      matched;
+
+    ngx_memzero(&base, sizeof(base));
+    ngx_memzero(&target, sizeof(target));
+    root = ngx_sa_open_root(&ctx->root);
+    if (root == NGX_INVALID_FILE) { return NGX_DECLINED; }
+    /* The root owner is sufficient even when its ACL projection is unusable. */
+    (void) ngx_sa_get_path_access(ctx->pool, root, &base);
+    ngx_close_file(root);
+    if (base.owner.len == 0
+        || ngx_sa_get_path_access(ctx->pool, fd, &target) != NGX_OK
+        || !target.usable)
+    {
+        return NGX_DECLINED;
+    }
+    if (ngx_sa_groups(ctx, &base.owner, &groups, &n) != NGX_OK) {
+        return NGX_DECLINED;
+    }
+    if (ngx_sa_id_equal(&base.owner, &target.owner)) {
+        bits = target.owner_bits;
+    } else {
+        bits = 0;
+        matched = 0;
+        for (i = 0; i < target.n; i++) {
+            for (j = 0; j < n; j++) {
+                if (ngx_sa_id_equal(&target.groups[i].id, &groups[j])) {
+                    matched = 1;
+                    bits |= target.groups[i].bits;
+                    break;
+                }
+            }
+        }
+        if (!matched) { bits = target.other_bits; }
+    }
+    return (bits & NGX_SA_READ) ? NGX_OK : NGX_DECLINED;
+}
diff --git a/src/core/ngx_symlink_access.h b/src/core/ngx_symlink_access.h
new file mode 100644
index 0000000..17357cc
--- /dev/null
+++ b/src/core/ngx_symlink_access.h
@@ -0,0 +1,50 @@
+/* Symlink target access policy. SPDX-License-Identifier: BSD-2-Clause */
+#ifndef _NGX_SYMLINK_ACCESS_H_INCLUDED_
+#define _NGX_SYMLINK_ACCESS_H_INCLUDED_
+
+#define NGX_SA_READ        4
+#define NGX_SA_WRITE       2
+#define NGX_SA_EXECUTE     1
+#define NGX_SA_MAX_GROUPS  4096
+
+typedef ngx_str_t ngx_sa_id_t;
+
+typedef struct {
+    ngx_sa_id_t  id;
+    ngx_uint_t   bits;
+} ngx_sa_group_access_t;
+
+typedef struct {
+    ngx_sa_id_t             owner;
+    ngx_uint_t              owner_bits;
+    ngx_uint_t              other_bits;
+    ngx_uint_t              n;
+    ngx_sa_group_access_t  *groups;
+    ngx_flag_t              usable;
+} ngx_sa_access_t;
+
+typedef struct ngx_sa_cache_s ngx_sa_cache_t;
+typedef struct ngx_symlink_access_s ngx_symlink_access_t;
+
+struct ngx_symlink_access_s {
+    ngx_str_t        root;
+    ngx_pool_t      *pool;
+    ngx_sa_cache_t  *cache;
+};
+
+ngx_sa_cache_t *ngx_sa_cache_create(ngx_pool_t *pool, ngx_uint_t max,
+    time_t valid, time_t negative_valid);
+ngx_int_t ngx_sa_id_copy(ngx_pool_t *pool, ngx_sa_id_t *id,
+    const void *data, size_t len);
+ngx_int_t ngx_sa_id_equal(const ngx_sa_id_t *a, const ngx_sa_id_t *b);
+ngx_int_t ngx_sa_get_user_groups(ngx_pool_t *pool, ngx_sa_id_t *user,
+    ngx_sa_id_t **groups, ngx_uint_t *n);
+ngx_int_t ngx_sa_get_path_access(ngx_pool_t *pool, ngx_fd_t fd,
+    ngx_sa_access_t *access);
+ngx_fd_t ngx_sa_open_root(ngx_str_t *root);
+ngx_int_t ngx_sa_check(ngx_symlink_access_t *ctx, ngx_fd_t fd);
+ngx_fd_t ngx_symlink_access_open(ngx_str_t *name, ngx_open_file_info_t *of,
+    ngx_symlink_access_t *ctx, ngx_int_t mode, ngx_int_t create,
+    ngx_int_t access, ngx_log_t *log);
+
+#endif
