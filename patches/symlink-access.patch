diff --git a/src/os/unix/ngx_symlink_access_unix.c b/src/os/unix/ngx_symlink_access_unix.c
new file mode 100644
index 0000000..9dce0b3
--- /dev/null
+++ b/src/os/unix/ngx_symlink_access_unix.c
@@ -0,0 +1,187 @@
+/* Symlink target access policy. SPDX-License-Identifier: BSD-2-Clause */
+#include <ngx_config.h>
+#include <ngx_core.h>
+#include <ngx_symlink_access.h>
+#include <pwd.h>
+#include <grp.h>
+
+ngx_int_t
+ngx_sa_get_path_access(ngx_pool_t *pool, ngx_fd_t fd, ngx_sa_access_t *a)
+{
+    struct stat st;
+    ngx_memzero(a, sizeof(*a));
+    if (fstat(fd, &st) == -1) { return NGX_ERROR; }
+    if (ngx_sa_id_copy(pool, &a->owner, &st.st_uid, sizeof(st.st_uid)) != NGX_OK) {
+        return NGX_ERROR;
+    }
+    a->groups = ngx_pcalloc(pool, sizeof(ngx_sa_group_access_t));
+    if (a->groups == NULL
+        || ngx_sa_id_copy(pool, &a->groups[0].id, &st.st_gid,
+                          sizeof(st.st_gid)) != NGX_OK)
+    {
+        return NGX_ERROR;
+    }
+    a->n = 1;
+    a->owner_bits = (st.st_mode >> 6) & 7;
+    a->groups[0].bits = (st.st_mode >> 3) & 7;
+    a->other_bits = st.st_mode & 7;
+    a->usable = 1;
+    return NGX_OK;
+}
+
+ngx_int_t
+ngx_sa_get_user_groups(ngx_pool_t *pool, ngx_sa_id_t *user,
+    ngx_sa_id_t **groups, ngx_uint_t *count)
+{
+#if (NGX_HAVE_GETGROUPLIST)
+    uid_t uid;
+#if defined(__APPLE__)
+    int *gids;
+#else
+    gid_t *gids;
+#endif
+    gid_t gid;
+    struct passwd pw, *result;
+    char *buf;
+    size_t size;
+    int rc, n, i;
+
+    *groups = NULL; *count = 0;
+    if (user->len != sizeof(uid)) { return NGX_DECLINED; }
+    ngx_memcpy(&uid, user->data, sizeof(uid));
+    for (size = 4096; size <= 1024 * 1024; size *= 2) {
+        buf = ngx_alloc(size, pool->log);
+        if (buf == NULL) { return NGX_ERROR; }
+        rc = getpwuid_r(uid, &pw, buf, size, &result);
+        if (rc != ERANGE) { break; }
+        ngx_free(buf);
+    }
+    if (size > 1024 * 1024) { return NGX_DECLINED; }
+    if (rc != 0 || result == NULL) { ngx_free(buf); return NGX_DECLINED; }
+    gids = ngx_alloc(NGX_SA_MAX_GROUPS * sizeof(*gids), pool->log);
+    if (gids == NULL) { ngx_free(buf); return NGX_ERROR; }
+    n = NGX_SA_MAX_GROUPS;
+    rc = getgrouplist(pw.pw_name, pw.pw_gid, gids, &n);
+    ngx_free(buf);
+    if (rc == -1 || n < 1 || n > NGX_SA_MAX_GROUPS) {
+        ngx_free(gids); return NGX_DECLINED;
+    }
+    *groups = ngx_pcalloc(pool, n * sizeof(ngx_sa_id_t));
+    if (*groups == NULL) { ngx_free(gids); return NGX_ERROR; }
+    for (i = 0; i < n; i++) {
+        gid = (gid_t) gids[i];
+        if (ngx_sa_id_copy(pool, &(*groups)[i], &gid, sizeof(gid)) != NGX_OK) {
+            ngx_free(gids); return NGX_ERROR;
+        }
+    }
+    ngx_free(gids);
+    *count = (ngx_uint_t) n;
+    return NGX_OK;
+#else
+    *groups = NULL; *count = 0;
+    return NGX_DECLINED;
+#endif
+}
+
+ngx_fd_t
+ngx_sa_open_root(ngx_str_t *root)
+{
+    ngx_fd_t fd;
+    struct stat st;
+    if (root->len == 0) { return NGX_INVALID_FILE; }
+    fd = ngx_open_file(root->data, NGX_FILE_SEARCH|NGX_FILE_NONBLOCK,
+                       NGX_FILE_OPEN, 0);
+    if (fd != NGX_INVALID_FILE && (fstat(fd, &st) == -1 || !S_ISDIR(st.st_mode))) {
+        ngx_close_file(fd); return NGX_INVALID_FILE;
+    }
+    return fd;
+}
+
+ngx_fd_t
+ngx_symlink_access_open(ngx_str_t *name, ngx_open_file_info_t *of,
+    ngx_symlink_access_t *ctx, ngx_int_t mode, ngx_int_t create,
+    ngx_int_t access, ngx_log_t *log)
+{
+#if (NGX_HAVE_OPENAT)
+    ngx_fd_t fd, parent;
+    char *path, *p, *end;
+    int flags;
+    ngx_flag_t linked, last, restricted;
+    struct stat st, lst;
+    ngx_err_t err;
+
+    fd = NGX_INVALID_FILE;
+    parent = NGX_AT_FDCWD;
+    linked = 0;
+    err = NGX_EACCES;
+    if (create != NGX_FILE_OPEN || of->log || name->len == 0) { goto failed; }
+    path = ngx_pnalloc(ctx->pool, name->len + 1);
+    if (path == NULL) { goto failed; }
+    ngx_memcpy(path, name->data, name->len);
+    path[name->len] = '\0';
+    p = path;
+    if (*p == '/') {
+        parent = open("/", NGX_FILE_SEARCH|NGX_FILE_NONBLOCK);
+        if (parent == NGX_INVALID_FILE) { err = ngx_errno; goto failed; }
+        while (*p == '/') { p++; }
+    }
+    for ( ;; ) {
+        end = p;
+        while (*end && *end != '/') { end++; }
+        last = (*end == '\0');
+        if (!last) { *end = '\0'; }
+        flags = last ? (int) mode : NGX_FILE_SEARCH|NGX_FILE_NONBLOCK;
+        /* A trailing slash is resolved as '.', preserving directory semantics. */
+        fd = openat(parent, *p ? p : ".", flags | O_NOFOLLOW);
+        if (fd == NGX_INVALID_FILE) {
+            err = ngx_errno;
+            if (err != NGX_ELOOP && err != NGX_ENOTDIR) { goto failed; }
+            linked = 1;
+            restricted = (size_t) (p - path) >= of->disable_symlinks_from;
+            if (restricted && of->disable_symlinks == NGX_DISABLE_SYMLINKS_ON) {
+                err = NGX_ELOOP; goto failed;
+            }
+            fd = openat(parent, *p ? p : ".", flags);
+            if (fd == NGX_INVALID_FILE) { err = ngx_errno; goto failed; }
+            if (restricted
+                && of->disable_symlinks == NGX_DISABLE_SYMLINKS_NOTOWNER)
+            {
+                if (fstat(fd, &st) == -1
+                    || fstatat(parent, p, &lst, AT_SYMLINK_NOFOLLOW) == -1)
+                {
+                    err = ngx_errno; goto failed;
+                }
+                if (st.st_uid != lst.st_uid) { err = NGX_ELOOP; goto failed; }
+            }
+        }
+        if (fstat(fd, &st) == -1) { err = ngx_errno; goto failed; }
+        /* SEARCH always includes O_DIRECTORY: O_PATH cannot return a link here. */
+        if (last) { break; }
+        if (!S_ISDIR(st.st_mode)) { err = NGX_ENOTDIR; goto failed; }
+        if (parent != NGX_AT_FDCWD) { ngx_close_file(parent); }
+        parent = fd;
+        fd = NGX_INVALID_FILE;
+        p = end + 1;
+        while (*p == '/') { p++; }
+    }
+    if (linked && !S_ISDIR(st.st_mode)) {
+        if (!S_ISREG(st.st_mode)
+            || ngx_sa_check(ctx, fd) != NGX_OK)
+        {
+            err = NGX_EACCES; goto failed;
+        }
+    }
+    if (parent != NGX_AT_FDCWD) { ngx_close_file(parent); }
+    return fd;
+
+failed:
+    if (fd != NGX_INVALID_FILE) { ngx_close_file(fd); }
+    if (parent != NGX_AT_FDCWD) { ngx_close_file(parent); }
+    of->err = err;
+#else
+    of->err = NGX_EACCES;
+#endif
+    of->failed = "symlink_access";
+    ngx_set_errno(of->err);
+    return NGX_INVALID_FILE;
+}
diff --git a/src/os/win32/ngx_symlink_access_win32.c b/src/os/win32/ngx_symlink_access_win32.c
new file mode 100644
index 0000000..8c88bd7
--- /dev/null
+++ b/src/os/win32/ngx_symlink_access_win32.c
@@ -0,0 +1,374 @@
+/* Symlink target access policy. SPDX-License-Identifier: BSD-2-Clause */
+#include <ngx_config.h>
+#include <ngx_core.h>
+#include <ngx_symlink_access.h>
+#include <aclapi.h>
+#include <authz.h>
+#include <winternl.h>
+#include <winioctl.h>
+
+/* Native relative opens keep every path component anchored to a directory. */
+typedef NTSTATUS (NTAPI *ngx_sa_nt_open_pt)(PHANDLE, ACCESS_MASK,
+    POBJECT_ATTRIBUTES, PIO_STATUS_BLOCK, PLARGE_INTEGER, ULONG, ULONG,
+    ULONG, ULONG, PVOID, ULONG);
+typedef ULONG (WINAPI *ngx_sa_nt_error_pt)(NTSTATUS);
+
+static WCHAR *
+ngx_sa_wide(ngx_pool_t *pool, ngx_str_t *path)
+{
+    int n;
+    WCHAR *w;
+    if (path->len == 0 || path->len > 32760) { return NULL; }
+    n = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS,
+                           (char *) path->data, (int) path->len, NULL, 0);
+    if (n == 0) { return NULL; }
+    w = ngx_palloc(pool, (n + 1) * sizeof(WCHAR));
+    if (w == NULL) { return NULL; }
+    if (!MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS,
+                            (char *) path->data, (int) path->len, w, n))
+    {
+        return NULL;
+    }
+    w[n] = 0;
+    return w;
+}
+
+static ngx_int_t
+ngx_sa_sid_type(ngx_pool_t *pool, PSID sid, SID_NAME_USE *type)
+{
+    WCHAR *name, *domain;
+    DWORD n = 0, d = 0;
+    LookupAccountSidW(NULL, sid, NULL, &n, NULL, &d, type);
+    if (GetLastError() != ERROR_INSUFFICIENT_BUFFER || n > 32768 || d > 32768) {
+        return NGX_DECLINED;
+    }
+    name = ngx_palloc(pool, (n + 1) * sizeof(WCHAR));
+    domain = ngx_palloc(pool, (d + 1) * sizeof(WCHAR));
+    if (name == NULL || domain == NULL
+        || !LookupAccountSidW(NULL, sid, name, &n, domain, &d, type))
+    {
+        return NGX_DECLINED;
+    }
+    return NGX_OK;
+}
+
+ngx_int_t
+ngx_sa_get_user_groups(ngx_pool_t *pool, ngx_sa_id_t *user,
+    ngx_sa_id_t **groups, ngx_uint_t *count)
+{
+    AUTHZ_RESOURCE_MANAGER_HANDLE rm = NULL;
+    AUTHZ_CLIENT_CONTEXT_HANDLE ctx = NULL;
+    LUID luid;
+    TOKEN_GROUPS *tg;
+    SID_NAME_USE type;
+    DWORD size = 0, i, n;
+    ngx_int_t rc = NGX_DECLINED;
+
+    *groups = NULL; *count = 0;
+    if (!IsValidSid(user->data)
+        || ngx_sa_sid_type(pool, user->data, &type) != NGX_OK
+        || type != SidTypeUser)
+    {
+        return NGX_DECLINED;
+    }
+    ngx_memzero(&luid, sizeof(luid));
+    if (!AuthzInitializeResourceManager(AUTHZ_RM_FLAG_NO_AUDIT, NULL, NULL,
+                                       NULL, L"symlink_access", &rm))
+    {
+        return NGX_DECLINED;
+    }
+    if (!AuthzInitializeContextFromSid(0, user->data, rm, NULL, luid, NULL, &ctx)) {
+        goto done;
+    }
+    AuthzGetInformationFromContext(ctx, AuthzContextInfoGroupsSids, 0, &size, NULL);
+    if (GetLastError() != ERROR_INSUFFICIENT_BUFFER
+        || size < sizeof(TOKEN_GROUPS) || size > 1024 * 1024)
+    {
+        goto done;
+    }
+    tg = ngx_palloc(pool, size);
+    if (tg == NULL
+        || !AuthzGetInformationFromContext(ctx, AuthzContextInfoGroupsSids,
+                                           size, &size, tg)
+        || tg->GroupCount > NGX_SA_MAX_GROUPS)
+    {
+        goto done;
+    }
+    *groups = ngx_pcalloc(pool, (tg->GroupCount + 1) * sizeof(ngx_sa_id_t));
+    if (*groups == NULL) { goto done; }
+    n = 0;
+    for (i = 0; i < tg->GroupCount; i++) {
+        if (!(tg->Groups[i].Attributes & SE_GROUP_ENABLED)
+            || (tg->Groups[i].Attributes & SE_GROUP_USE_FOR_DENY_ONLY))
+        {
+            continue;
+        }
+        if (!IsValidSid(tg->Groups[i].Sid)
+            || ngx_sa_id_copy(pool, &(*groups)[n], tg->Groups[i].Sid,
+                              GetLengthSid(tg->Groups[i].Sid)) != NGX_OK)
+        {
+            goto done;
+        }
+        n++;
+    }
+    *count = n;
+    rc = NGX_OK;
+done:
+    if (ctx) { AuthzFreeContext(ctx); }
+    AuthzFreeResourceManager(rm);
+    return rc;
+}
+
+ngx_int_t
+ngx_sa_get_path_access(ngx_pool_t *pool, ngx_fd_t fd, ngx_sa_access_t *a)
+{
+    PSECURITY_DESCRIPTOR sd = NULL;
+    PSID owner = NULL, sid;
+    PACL dacl = NULL;
+    ACE_HEADER *header;
+    ACCESS_ALLOWED_ACE *ace;
+    SID_NAME_USE type;
+    GENERIC_MAPPING mapping = { FILE_GENERIC_READ, FILE_GENERIC_WRITE,
+                                FILE_GENERIC_EXECUTE, FILE_ALL_ACCESS };
+    DWORD i, mask;
+    ngx_uint_t bits;
+    ngx_int_t rc = NGX_DECLINED;
+
+    ngx_memzero(a, sizeof(*a));
+    if (GetSecurityInfo(fd, SE_FILE_OBJECT,
+                        OWNER_SECURITY_INFORMATION|DACL_SECURITY_INFORMATION,
+                        &owner, NULL, &dacl, NULL, &sd) != ERROR_SUCCESS)
+    {
+        return NGX_DECLINED;
+    }
+    if (owner == NULL || !IsValidSid(owner)
+        || ngx_sa_id_copy(pool, &a->owner, owner, GetLengthSid(owner)) != NGX_OK)
+    {
+        goto done;
+    }
+    if (dacl == NULL) {
+        a->owner_bits = a->other_bits = 7;
+        a->usable = 1;
+        rc = NGX_OK;
+        goto done;
+    }
+    if (!IsValidAcl(dacl) || dacl->AceCount > NGX_SA_MAX_GROUPS) { goto done; }
+    a->groups = ngx_pcalloc(pool, (dacl->AceCount + 1)
+                                 * sizeof(ngx_sa_group_access_t));
+    if (a->groups == NULL) { goto done; }
+    for (i = 0; i < dacl->AceCount; i++) {
+        if (!GetAce(dacl, i, (void **) &header)) { goto done; }
+        if (header->AceFlags & INHERIT_ONLY_ACE) { continue; }
+        if (header->AceType != ACCESS_ALLOWED_ACE_TYPE) { goto done; }
+        ace = (ACCESS_ALLOWED_ACE *) header;
+        sid = (PSID) &ace->SidStart;
+        if (!IsValidSid(sid)) { goto done; }
+        mask = ace->Mask;
+        MapGenericMask(&mask, &mapping);
+        bits = ((mask & FILE_READ_DATA) ? NGX_SA_READ : 0)
+               | ((mask & FILE_WRITE_DATA) ? NGX_SA_WRITE : 0)
+               | ((mask & FILE_EXECUTE) ? NGX_SA_EXECUTE : 0);
+        if (IsWellKnownSid(sid, WinWorldSid)) {
+            a->other_bits |= bits;
+        } else if (EqualSid(sid, owner)) {
+            a->owner_bits |= bits;
+        } else {
+            if (ngx_sa_sid_type(pool, sid, &type) != NGX_OK
+                || (type != SidTypeGroup && type != SidTypeAlias
+                    && type != SidTypeWellKnownGroup))
+            {
+                goto done;
+            }
+            if (ngx_sa_id_copy(pool, &a->groups[a->n].id, sid,
+                               GetLengthSid(sid)) != NGX_OK)
+            {
+                goto done;
+            }
+            a->groups[a->n++].bits = bits;
+        }
+    }
+    a->owner_bits |= a->other_bits;
+    for (i = 0; i < a->n; i++) { a->groups[i].bits |= a->other_bits; }
+    a->usable = 1;
+    rc = NGX_OK;
+done:
+    LocalFree(sd);
+    return rc;
+}
+
+ngx_fd_t
+ngx_sa_open_root(ngx_str_t *root)
+{
+    ngx_pool_t *pool;
+    WCHAR *path;
+    HANDLE fd = INVALID_HANDLE_VALUE;
+    BY_HANDLE_FILE_INFORMATION fi;
+    pool = ngx_create_pool(4096, ngx_cycle->log);
+    if (pool == NULL) { return fd; }
+    path = ngx_sa_wide(pool, root);
+    if (path) {
+        fd = CreateFileW(path, READ_CONTROL|FILE_READ_ATTRIBUTES,
+                         FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE,
+                         NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL);
+        if (fd != INVALID_HANDLE_VALUE
+            && (!GetFileInformationByHandle(fd, &fi)
+                || !(fi.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)))
+        {
+            CloseHandle(fd); fd = INVALID_HANDLE_VALUE;
+        }
+    }
+    ngx_destroy_pool(pool);
+    return fd;
+}
+
+static HANDLE
+ngx_sa_relative(HANDLE parent, WCHAR *part, USHORT bytes, ULONG options,
+    ACCESS_MASK access, DWORD *error)
+{
+    HMODULE dll;
+    ngx_sa_nt_open_pt openfn;
+    ngx_sa_nt_error_pt errfn;
+    UNICODE_STRING name;
+    OBJECT_ATTRIBUTES oa;
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+    HANDLE fd = INVALID_HANDLE_VALUE;
+
+    dll = GetModuleHandleW(L"ntdll.dll");
+    if (dll == NULL) { *error = ERROR_ACCESS_DENIED; return fd; }
+    /* Copy function pointers without compiler-specific incompatible casts. */
+    { FARPROC p = GetProcAddress(dll, "NtCreateFile");
+      ngx_memcpy(&openfn, &p, sizeof(openfn)); }
+    { FARPROC p = GetProcAddress(dll, "RtlNtStatusToDosError");
+      ngx_memcpy(&errfn, &p, sizeof(errfn)); }
+    if (openfn == NULL || errfn == NULL) {
+        *error = ERROR_ACCESS_DENIED; return fd;
+    }
+    name.Buffer = part; name.Length = bytes; name.MaximumLength = bytes;
+    ngx_memzero(&oa, sizeof(oa));
+    oa.Length = sizeof(oa);
+    oa.RootDirectory = parent;
+    oa.ObjectName = &name;
+    oa.Attributes = 0x40; /* OBJ_CASE_INSENSITIVE */
+    status = openfn(&fd, access|SYNCHRONIZE, &oa, &io, NULL, 0,
+                    FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE,
+                    1 /* FILE_OPEN */, options | 0x20 /* FILE_SYNCHRONOUS_IO_NONALERT */,
+                    NULL, 0);
+    if (status < 0) { *error = errfn(status); return INVALID_HANDLE_VALUE; }
+    return fd;
+}
+
+ngx_fd_t
+ngx_symlink_access_open(ngx_str_t *name, ngx_open_file_info_t *of,
+    ngx_symlink_access_t *ctx, ngx_int_t mode, ngx_int_t create,
+    ngx_int_t access, ngx_log_t *log)
+{
+    WCHAR *path, *p, *end;
+    HANDLE parent = INVALID_HANDLE_VALUE, fd = INVALID_HANDLE_VALUE;
+    DWORD err = ERROR_ACCESS_DENIED, returned, tag;
+    BY_HANDLE_FILE_INFORMATION fi;
+    BYTE reparse[MAXIMUM_REPARSE_DATA_BUFFER_SIZE];
+    ACCESS_MASK desired;
+    ngx_flag_t linked = 0, last;
+    size_t n;
+
+    if (create != NGX_FILE_OPEN || of->log) { goto failed; }
+    path = ngx_sa_wide(ctx->pool, name);
+    if (path == NULL) { goto failed; }
+    for (p = path; *p; p++) { if (*p == L'/') { *p = L'\\'; } }
+    n = wcslen(path);
+    if (n >= 3 && path[1] == L':' && path[2] == L'\\'
+        && ((path[0] >= L'A' && path[0] <= L'Z')
+            || (path[0] >= L'a' && path[0] <= L'z')))
+    {
+        p = path + 3;
+    } else if (n > 5 && path[0] == L'\\' && path[1] == L'\\'
+               && path[2] != L'?' && path[2] != L'.')
+    {
+        p = wcschr(path + 2, L'\\');
+        if (p == NULL || p == path + 2) { goto failed; }
+        p = wcschr(p + 1, L'\\');
+        if (p == NULL) { goto failed; }
+        p++;
+    } else { goto failed; }
+    { WCHAR saved = *p;
+      *p = 0;
+      parent = CreateFileW(path, FILE_READ_ATTRIBUTES|FILE_TRAVERSE,
+                          FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE,
+                          NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL);
+      *p = saved; }
+    if (parent == INVALID_HANDLE_VALUE) { err = GetLastError(); goto failed; }
+    if (!*p) { fd = parent; parent = INVALID_HANDLE_VALUE; goto done; }
+    for ( ;; ) {
+        end = p;
+        while (*end && *end != L'\\') { end++; }
+        last = (*end == 0 || (end[0] == L'\\' && end[1] == 0));
+        if (end == p || (end - p == 1 && p[0] == L'.')
+            || (end - p == 2 && p[0] == L'.' && p[1] == L'.'))
+        {
+            err = ERROR_ACCESS_DENIED; goto failed;
+        }
+        /* Preserve nginx's rejection of streams, device names and trailing dots. */
+        if (p[end - p - 1] == L'.' || p[end - p - 1] == L' ') {
+            err = ERROR_ACCESS_DENIED; goto failed;
+        }
+        { WCHAR *q;
+          for (q = p; q < end; q++) {
+              if (*q == L':' || *q < 32) { err = ERROR_ACCESS_DENIED; goto failed; }
+          } }
+        desired = last ? (ACCESS_MASK) mode|READ_CONTROL|FILE_READ_ATTRIBUTES
+                       : FILE_READ_ATTRIBUTES|FILE_TRAVERSE;
+        fd = ngx_sa_relative(parent, p, (USHORT) ((end - p) * sizeof(WCHAR)),
+                              0x00200000 /* FILE_OPEN_REPARSE_POINT */,
+                              desired, &err);
+        if (fd == INVALID_HANDLE_VALUE) { goto failed; }
+        if (!GetFileInformationByHandle(fd, &fi)) { err = GetLastError(); goto failed; }
+        if (fi.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) {
+            if (!DeviceIoControl(fd, FSCTL_GET_REPARSE_POINT, NULL, 0,
+                                  reparse, sizeof(reparse), &returned, NULL)
+                || returned < sizeof(DWORD))
+            {
+                err = ERROR_ACCESS_DENIED; goto failed;
+            }
+            ngx_memcpy(&tag, reparse, sizeof(tag));
+            if (tag != IO_REPARSE_TAG_SYMLINK && tag != IO_REPARSE_TAG_MOUNT_POINT) {
+                err = ERROR_ACCESS_DENIED; goto failed;
+            }
+            linked = 1;
+            CloseHandle(fd);
+            fd = ngx_sa_relative(parent, p, (USHORT) ((end - p) * sizeof(WCHAR)),
+                                  0, desired, &err);
+            if (fd == INVALID_HANDLE_VALUE) { goto failed; }
+            if (!GetFileInformationByHandle(fd, &fi)) { err = GetLastError(); goto failed; }
+        }
+        if (last) {
+            if (*end == L'\\' && !(fi.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) {
+                err = ERROR_PATH_NOT_FOUND; goto failed;
+            }
+            break;
+        }
+        if (!(fi.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) {
+            err = ERROR_PATH_NOT_FOUND; goto failed;
+        }
+        CloseHandle(parent); parent = fd; fd = INVALID_HANDLE_VALUE;
+        p = end + 1;
+    }
+    if (linked && !(fi.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)
+        && ngx_sa_check(ctx, fd) != NGX_OK)
+    {
+        err = ERROR_ACCESS_DENIED; goto failed;
+    }
+done:
+    if (parent != INVALID_HANDLE_VALUE) { CloseHandle(parent); }
+    return fd;
+failed:
+    if (fd != INVALID_HANDLE_VALUE) { CloseHandle(fd); }
+    if (parent != INVALID_HANDLE_VALUE) { CloseHandle(parent); }
+    if (linked && err != ERROR_FILE_NOT_FOUND && err != ERROR_PATH_NOT_FOUND) {
+        err = ERROR_ACCESS_DENIED;
+    }
+    of->err = err;
+    of->failed = "symlink_access";
+    SetLastError(err);
+    return INVALID_HANDLE_VALUE;
+}
