diff --git a/src/http/modules/ngx_http_symlink_access_module.c b/src/http/modules/ngx_http_symlink_access_module.c
new file mode 100644
index 0000000..6c6c4cf
--- /dev/null
+++ b/src/http/modules/ngx_http_symlink_access_module.c
@@ -0,0 +1,516 @@
+/* Targeted symlink access checks. SPDX-License-Identifier: BSD-2-Clause */
+#include <ngx_config.h>
+#include <ngx_core.h>
+#include <ngx_http.h>
+
+#if (NGX_WIN32)
+#include <aclapi.h>
+#include <authz.h>
+#include <winternl.h>
+#include <winioctl.h>
+typedef struct { u_char data[SECURITY_MAX_SID_SIZE]; } ngx_sa_id_t;
+typedef TOKEN_GROUPS ngx_sa_groups_t;
+#define NGX_SA_ROOT_MODE (READ_CONTROL|FILE_READ_ATTRIBUTES)
+#else
+#include <pwd.h>
+#include <grp.h>
+typedef uid_t ngx_sa_id_t;
+#if defined(__APPLE__)
+typedef int ngx_sa_gid_t;
+#else
+typedef gid_t ngx_sa_gid_t;
+#endif
+typedef struct {
+    int n;
+    ngx_sa_gid_t ids[];
+} ngx_sa_groups_t;
+#define NGX_SA_ROOT_MODE (NGX_FILE_SEARCH|NGX_FILE_NONBLOCK)
+#endif
+
+typedef struct {
+    ngx_sa_id_t owner;
+    ngx_sa_groups_t *groups;
+} ngx_sa_user_t;
+
+typedef struct {
+    ngx_pool_t *pool;
+    time_t created;
+    ngx_sa_user_t user;
+} ngx_sa_entry_t;
+
+typedef struct {
+    ngx_uint_t max;
+    time_t valid;
+    ngx_sa_entry_t **slots;
+} ngx_sa_cache_t;
+
+#if (NGX_WIN32)
+static ngx_int_t
+ngx_sa_sid_type(ngx_pool_t *pool, PSID sid, SID_NAME_USE *type)
+{
+    WCHAR *name, *domain;
+    DWORD n = 0, d = 0;
+    LookupAccountSidW(NULL, sid, NULL, &n, NULL, &d, type);
+    if (GetLastError() != ERROR_INSUFFICIENT_BUFFER || n > 32768 || d > 32768) {
+        return NGX_DECLINED;
+    }
+    name = ngx_palloc(pool, (n + 1) * sizeof(WCHAR));
+    domain = ngx_palloc(pool, (d + 1) * sizeof(WCHAR));
+    return name && domain && LookupAccountSidW(NULL, sid, name, &n, domain, &d, type)
+           ? NGX_OK : NGX_DECLINED;
+}
+
+static ngx_int_t
+ngx_sa_owner(ngx_fd_t fd, ngx_sa_id_t *id)
+{
+    PSECURITY_DESCRIPTOR sd = NULL;
+    PSID owner;
+    ngx_int_t rc = NGX_DECLINED;
+    if (GetSecurityInfo(fd, SE_FILE_OBJECT, OWNER_SECURITY_INFORMATION,
+                        &owner, NULL, NULL, NULL, &sd) != ERROR_SUCCESS) {
+        return rc;
+    }
+    ngx_memzero(id, sizeof(*id));
+    if (owner && IsValidSid(owner) && CopySid(sizeof(id->data), id->data, owner)) {
+        rc = NGX_OK;
+    }
+    LocalFree(sd);
+    return rc;
+}
+
+static ngx_int_t
+ngx_sa_user_groups(ngx_pool_t *pool, ngx_sa_user_t *user)
+{
+    AUTHZ_RESOURCE_MANAGER_HANDLE rm = NULL;
+    AUTHZ_CLIENT_CONTEXT_HANDLE ctx = NULL;
+    SID_NAME_USE type;
+    LUID luid = { 0, 0 };
+    DWORD size = 0;
+    ngx_int_t rc = NGX_DECLINED;
+    if (ngx_sa_sid_type(pool, user->owner.data, &type) != NGX_OK || type != SidTypeUser
+        || !AuthzInitializeResourceManager(AUTHZ_RM_FLAG_NO_AUDIT, NULL, NULL,
+                                           NULL, L"symlink_access", &rm)) {
+        return rc;
+    }
+    if (!AuthzInitializeContextFromSid(0, user->owner.data, rm, NULL, luid, NULL, &ctx)) {
+        goto done;
+    }
+    AuthzGetInformationFromContext(ctx, AuthzContextInfoGroupsSids, 0, &size, NULL);
+    if (GetLastError() != ERROR_INSUFFICIENT_BUFFER
+        || size < sizeof(TOKEN_GROUPS) || size > 1024 * 1024) { goto done; }
+    user->groups = ngx_palloc(pool, size);
+    if (user->groups && AuthzGetInformationFromContext(ctx, AuthzContextInfoGroupsSids,
+                                                      size, &size, user->groups)
+        && user->groups->GroupCount <= 4096) {
+        rc = NGX_OK;
+    }
+done:
+    if (ctx) { AuthzFreeContext(ctx); }
+    AuthzFreeResourceManager(rm);
+    return rc;
+}
+
+/* Return normalized rwx bits with owner/group/other precedence; -1 denies. */
+static ngx_int_t
+ngx_sa_permissions(ngx_pool_t *pool, ngx_fd_t fd, ngx_sa_user_t *user)
+{
+    PSECURITY_DESCRIPTOR sd = NULL;
+    PSID owner, sid;
+    PACL acl;
+    ACE_HEADER *header;
+    ACCESS_ALLOWED_ACE *ace;
+    SID_NAME_USE type;
+    GENERIC_MAPPING map = { FILE_GENERIC_READ, FILE_GENERIC_WRITE,
+                            FILE_GENERIC_EXECUTE, FILE_ALL_ACCESS };
+    DWORD i, j, mask, attr;
+    ngx_int_t bits, own = 0, group = 0, other = 0, result = NGX_ERROR;
+    ngx_flag_t matched = 0;
+    if (GetSecurityInfo(fd, SE_FILE_OBJECT, OWNER_SECURITY_INFORMATION|DACL_SECURITY_INFORMATION,
+                        &owner, NULL, &acl, NULL, &sd) != ERROR_SUCCESS) { return result; }
+    if (!owner || !IsValidSid(owner)) { goto done; }
+    if (acl == NULL) { result = 7; goto done; }
+    if (!IsValidAcl(acl) || acl->AceCount > 4096) { goto done; }
+    for (i = 0; i < acl->AceCount; i++) {
+        if (!GetAce(acl, i, (void **) &header)) { goto done; }
+        if (header->AceFlags & INHERIT_ONLY_ACE) { continue; }
+        if (header->AceType != ACCESS_ALLOWED_ACE_TYPE) { goto done; }
+        ace = (ACCESS_ALLOWED_ACE *) header;
+        sid = (PSID) &ace->SidStart;
+        if (!IsValidSid(sid)) { goto done; }
+        mask = ace->Mask;
+        MapGenericMask(&mask, &map);
+        bits = ((mask & FILE_READ_DATA) ? 4 : 0) | ((mask & FILE_WRITE_DATA) ? 2 : 0)
+               | ((mask & FILE_EXECUTE) ? 1 : 0);
+        if (EqualSid(sid, owner)) { own |= bits; }
+        else if (IsWellKnownSid(sid, WinWorldSid)) { other |= bits; }
+        else {
+            if (ngx_sa_sid_type(pool, sid, &type) != NGX_OK
+                || (type != SidTypeGroup && type != SidTypeAlias && type != SidTypeWellKnownGroup)) {
+                goto done;
+            }
+            for (j = 0; j < user->groups->GroupCount; j++) {
+                attr = user->groups->Groups[j].Attributes;
+                if ((attr & SE_GROUP_ENABLED) && !(attr & SE_GROUP_USE_FOR_DENY_ONLY)
+                    && EqualSid(sid, user->groups->Groups[j].Sid)) {
+                    matched = 1;
+                    group |= bits;
+                }
+            }
+        }
+    }
+    result = other | (EqualSid(owner, user->owner.data) ? own : matched ? group : 0);
+done:
+    LocalFree(sd);
+    return result;
+}
+
+/* OBJ_DONT_REPARSE rejects reparses anywhere below the volume/share handle. */
+static ngx_fd_t
+ngx_sa_nofollow(ngx_str_t *name, ngx_pool_t *pool, ngx_flag_t *linked)
+{
+    typedef NTSTATUS (NTAPI *open_pt)(PHANDLE, ACCESS_MASK, POBJECT_ATTRIBUTES,
+        PIO_STATUS_BLOCK, PLARGE_INTEGER, ULONG, ULONG, ULONG, ULONG, PVOID, ULONG);
+    typedef ULONG (WINAPI *error_pt)(NTSTATUS);
+    open_pt openfn;
+    error_pt errfn;
+    FARPROC proc;
+    HANDLE root, fd = INVALID_HANDLE_VALUE;
+    WCHAR *path, *p, saved;
+    UNICODE_STRING part;
+    OBJECT_ATTRIBUTES oa;
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+    int n;
+    DWORD error = ERROR_ACCESS_DENIED;
+    if (!name->len || name->len > 32760) { goto failed; }
+    path = ngx_palloc(pool, (name->len + 1) * sizeof(WCHAR));
+    if (path == NULL) { goto failed; }
+    n = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, (char *) name->data,
+                           (int) name->len, path, (int) name->len);
+    if (!n) { goto failed; }
+    path[n] = 0;
+    for (p = path; *p; p++) { if (*p == L'/') { *p = L'\\'; } }
+    if (n >= 3 && path[1] == L':' && path[2] == L'\\') { p = path + 3; }
+    else if (n > 5 && path[0] == L'\\' && path[1] == L'\\'
+             && path[2] != L'?' && path[2] != L'.') {
+        p = wcschr(path + 2, L'\\');
+        if (p == NULL || p == path + 2) { goto failed; }
+        p = wcschr(p + 1, L'\\');
+        if (p == NULL) { goto failed; }
+        p++;
+    } else { goto failed; }
+    saved = *p;
+    *p = 0;
+    root = CreateFileW(path, FILE_READ_ATTRIBUTES|FILE_TRAVERSE,
+                       FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE,
+                       NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL);
+    *p = saved;
+    if (root == INVALID_HANDLE_VALUE) { return root; }
+    if (!*p) { return root; }
+    proc = GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "NtCreateFile");
+    ngx_memcpy(&openfn, &proc, sizeof(openfn));
+    proc = GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "RtlNtStatusToDosError");
+    ngx_memcpy(&errfn, &proc, sizeof(errfn));
+    if (openfn && errfn) {
+        part.Buffer = p;
+        part.Length = part.MaximumLength = (USHORT) (wcslen(p) * sizeof(WCHAR));
+        ngx_memzero(&oa, sizeof(oa));
+        oa.Length = sizeof(oa);
+        oa.RootDirectory = root;
+        oa.ObjectName = &part;
+        oa.Attributes = 0x1040; /* OBJ_DONT_REPARSE | OBJ_CASE_INSENSITIVE */
+        status = openfn(&fd, GENERIC_READ|SYNCHRONIZE, &oa, &io, NULL, 0,
+                        FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE,
+                        1 /* FILE_OPEN */, 0x20 /* synchronous */, NULL, 0);
+        if (status < 0) {
+            *linked = (ULONG) status == 0xc000050b; /* STATUS_REPARSE_POINT_ENCOUNTERED */
+            error = errfn(status);
+            fd = INVALID_HANDLE_VALUE;
+        }
+    }
+    CloseHandle(root);
+    if (fd != INVALID_HANDLE_VALUE) { return fd; }
+failed:
+    SetLastError(error);
+    return INVALID_HANDLE_VALUE;
+}
+
+static ngx_int_t
+ngx_sa_open(ngx_str_t *name, ngx_open_file_info_t *of, ngx_pool_t *pool, ngx_flag_t *linked)
+{
+    /* FileIdInfo: 64-bit volume ID + 128-bit file ID, including ReFS. */
+    typedef struct { ULONGLONG volume; BYTE id[16]; } file_id_t;
+    typedef BOOL (WINAPI *info_pt)(HANDLE, int, void *, DWORD);
+    file_id_t first, second;
+    info_pt info;
+    FARPROC proc;
+    ngx_fd_t probe;
+    ngx_int_t rc;
+    probe = ngx_sa_nofollow(name, pool, linked);
+    if (probe == INVALID_HANDLE_VALUE && !*linked) {
+        of->err = ngx_errno;
+        of->failed = "symlink_access";
+        return NGX_ERROR;
+    }
+    /* Retain nginx's path validation, metadata, directio and descriptor cleanup. */
+    rc = ngx_open_cached_file(NULL, name, of, pool);
+    if (rc == NGX_OK && !of->is_dir && probe != INVALID_HANDLE_VALUE) {
+        proc = GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "GetFileInformationByHandleEx");
+        ngx_memcpy(&info, &proc, sizeof(info));
+        *linked = !info || !info(probe, 18 /* FileIdInfo */, &first, sizeof(first))
+                  || !info(of->fd, 18, &second, sizeof(second))
+                  || ngx_memcmp(&first, &second, sizeof(first)) != 0;
+    }
+    if (probe != INVALID_HANDLE_VALUE) { CloseHandle(probe); }
+    if (rc != NGX_OK && *linked && of->err != NGX_ENOENT && of->err != NGX_ENOPATH) {
+        of->err = NGX_EACCES;
+    }
+    return rc;
+}
+
+#else
+static ngx_int_t
+ngx_sa_owner(ngx_fd_t fd, ngx_sa_id_t *id)
+{
+    struct stat st;
+    if (fstat(fd, &st) == -1) { return NGX_DECLINED; }
+    *id = st.st_uid;
+    return NGX_OK;
+}
+
+static ngx_int_t
+ngx_sa_user_groups(ngx_pool_t *pool, ngx_sa_user_t *user)
+{
+#if (NGX_HAVE_GETGROUPLIST)
+    struct passwd pw, *found;
+    char buf[16384];
+    ngx_sa_gid_t ids[4096];
+    int n = 4096;
+    if (getpwuid_r(user->owner, &pw, buf, sizeof(buf), &found) != 0 || found == NULL
+        || getgrouplist(pw.pw_name, pw.pw_gid, ids, &n) == -1 || n < 1 || n > 4096) {
+        return NGX_DECLINED;
+    }
+    user->groups = ngx_palloc(pool, offsetof(ngx_sa_groups_t, ids) + n * sizeof(ids[0]));
+    if (user->groups == NULL) { return NGX_DECLINED; }
+    user->groups->n = n;
+    ngx_memcpy(user->groups->ids, ids, n * sizeof(ids[0]));
+    return NGX_OK;
+#else
+    return NGX_DECLINED;
+#endif
+}
+
+static ngx_int_t
+ngx_sa_permissions(ngx_pool_t *pool, ngx_fd_t fd, ngx_sa_user_t *user)
+{
+    struct stat st;
+    int i;
+    if (fstat(fd, &st) == -1 || !S_ISREG(st.st_mode)) { return NGX_ERROR; }
+    if (st.st_uid == user->owner) { return (st.st_mode >> 6) & 7; }
+    for (i = 0; i < user->groups->n; i++) {
+        if (st.st_gid == (gid_t) user->groups->ids[i]) { return (st.st_mode >> 3) & 7; }
+    }
+    return st.st_mode & 7;
+}
+
+static ngx_int_t
+ngx_sa_open(ngx_str_t *name, ngx_open_file_info_t *of, ngx_pool_t *pool, ngx_flag_t *linked)
+{
+#if (NGX_HAVE_OPENAT)
+    ngx_open_file_info_t probe = *of;
+    ngx_int_t rc;
+    /* Successful no-follow open pins the served file; no path-only precheck. */
+    probe.disable_symlinks = NGX_DISABLE_SYMLINKS_ON;
+    probe.disable_symlinks_from = 0;
+    rc = ngx_open_cached_file(NULL, name, &probe, pool);
+    if (rc == NGX_OK) { *of = probe; return NGX_OK; }
+    if (probe.err != NGX_ELOOP && probe.err != NGX_ENOTDIR) { *of = probe; return rc; }
+    *linked = 1;
+    /* Honor the existing disable_symlinks policy on the followed open too. */
+    return ngx_open_cached_file(NULL, name, of, pool);
+#else
+    of->err = NGX_EACCES;
+    of->failed = "symlink_access";
+    return NGX_ERROR;
+#endif
+}
+#endif
+
+static void
+ngx_sa_cleanup(void *data)
+{
+    ngx_sa_cache_t *cache = data;
+    ngx_uint_t i;
+    for (i = 0; i < cache->max; i++) {
+        if (cache->slots[i]) { ngx_destroy_pool(cache->slots[i]->pool); }
+    }
+}
+
+static ngx_sa_user_t *
+ngx_sa_cached_user(ngx_sa_cache_t *cache, ngx_pool_t *request_pool, ngx_sa_id_t *owner)
+{
+    ngx_sa_entry_t *entry;
+    ngx_pool_t *pool = request_pool;
+    ngx_uint_t slot = 0;
+    time_t now = ngx_time();
+    ngx_flag_t enabled = cache->max && cache->valid;
+    if (enabled) {
+        slot = ngx_crc32_short((u_char *) owner, sizeof(*owner)) % cache->max;
+        entry = cache->slots[slot];
+        if (entry && ngx_memcmp(owner, &entry->user.owner, sizeof(*owner)) == 0
+            && now >= entry->created && now - entry->created < cache->valid) {
+            return &entry->user;
+        }
+        if (entry) { ngx_destroy_pool(entry->pool); cache->slots[slot] = NULL; }
+        pool = ngx_create_pool(4096, request_pool->log);
+        if (pool == NULL) { return NULL; }
+    }
+    entry = ngx_pcalloc(pool, sizeof(*entry));
+    if (entry) {
+        entry->pool = pool;
+        entry->created = now; /* Absolute expiry, measured before the slow lookup. */
+        entry->user.owner = *owner;
+        if (ngx_sa_user_groups(pool, &entry->user) == NGX_OK) {
+            if (enabled) { cache->slots[slot] = entry; }
+            return &entry->user;
+        }
+    }
+    if (enabled) { ngx_destroy_pool(pool); }
+    return NULL; /* Unknown identities and failed lookups never authorize. */
+}
+
+static void *
+ngx_sa_create_main(ngx_conf_t *cf)
+{
+    ngx_sa_cache_t *cache = ngx_pcalloc(cf->pool, sizeof(*cache));
+    if (cache) { cache->max = 1024; cache->valid = NGX_CONF_UNSET; }
+    return cache;
+}
+
+static char *
+ngx_sa_init_main(ngx_conf_t *cf, void *data)
+{
+    ngx_sa_cache_t *cache = data;
+    ngx_pool_cleanup_t *cln;
+    ngx_conf_init_value(cache->valid, 30);
+    if (!cache->max || !cache->valid) { cache->max = 0; return NGX_CONF_OK; }
+    cache->slots = ngx_pcalloc(cf->pool, cache->max * sizeof(ngx_sa_entry_t *));
+    cln = ngx_pool_cleanup_add(cf->pool, 0);
+    if (cache->slots == NULL || cln == NULL) { return NGX_CONF_ERROR; }
+    cln->handler = ngx_sa_cleanup;
+    cln->data = cache;
+    return NGX_CONF_OK;
+}
+
+static char *
+ngx_sa_cache_conf(ngx_conf_t *cf, ngx_command_t *cmd, void *data)
+{
+    ngx_sa_cache_t *cache = data;
+    ngx_str_t *v = cf->args->elts;
+    ngx_int_t n = ngx_atoi(v[1].data, v[1].len);
+    if (cache->valid != NGX_CONF_UNSET) { return "is duplicate"; }
+    cache->valid = ngx_parse_time(&v[2], 1);
+    if (n < 0 || n > 65536 || cache->valid == (time_t) NGX_ERROR) {
+        return "requires 0..65536 entries and a valid duration";
+    }
+    cache->max = n;
+    return NGX_CONF_OK;
+}
+
+static void *
+ngx_sa_create_loc(ngx_conf_t *cf)
+{
+    ngx_flag_t *enabled = ngx_palloc(cf->pool, sizeof(*enabled));
+    if (enabled) { *enabled = NGX_CONF_UNSET; }
+    return enabled;
+}
+
+static char *
+ngx_sa_merge_loc(ngx_conf_t *cf, void *parent, void *child)
+{
+    ngx_flag_t *prev = parent, *enabled = child;
+    ngx_conf_merge_value(*enabled, *prev, 0);
+    return NGX_CONF_OK;
+}
+
+static ngx_command_t ngx_sa_commands[] = {
+    { ngx_string("symlink_access"),
+      NGX_HTTP_MAIN_CONF|NGX_HTTP_SRV_CONF|NGX_HTTP_LOC_CONF|NGX_CONF_FLAG,
+      ngx_conf_set_flag_slot, NGX_HTTP_LOC_CONF_OFFSET, 0, NULL },
+    { ngx_string("symlink_access_cache"), NGX_HTTP_MAIN_CONF|NGX_CONF_TAKE2,
+      ngx_sa_cache_conf, NGX_HTTP_MAIN_CONF_OFFSET, 0, NULL },
+    ngx_null_command
+};
+
+static ngx_http_module_t ngx_sa_module_ctx = {
+    NULL, NULL, ngx_sa_create_main, ngx_sa_init_main,
+    NULL, NULL, ngx_sa_create_loc, ngx_sa_merge_loc
+};
+
+ngx_module_t ngx_http_symlink_access_module = {
+    NGX_MODULE_V1, &ngx_sa_module_ctx, ngx_sa_commands, NGX_HTTP_MODULE,
+    NULL, NULL, NULL, NULL, NULL, NULL, NULL, NGX_MODULE_V1_PADDING
+};
+
+ngx_flag_t
+ngx_http_symlink_access_enabled(ngx_http_request_t *r)
+{
+    ngx_flag_t *enabled = ngx_http_get_module_loc_conf(r, ngx_http_symlink_access_module);
+    return *enabled;
+}
+
+static ngx_int_t
+ngx_sa_check(ngx_http_request_t *r, ngx_fd_t fd)
+{
+    ngx_str_t variable = ngx_string("document_root");
+    ngx_http_variable_value_t *value;
+    ngx_sa_cache_t *cache;
+    ngx_sa_user_t *user;
+    ngx_sa_id_t owner;
+    ngx_file_info_t fi;
+    ngx_fd_t root;
+    u_char *path;
+    ngx_int_t rc;
+    value = ngx_http_get_variable(r, &variable, ngx_hash_key(variable.data, variable.len));
+    if (value == NULL || value->not_found || !value->len
+        || ngx_strlchr(value->data, value->data + value->len, '\0')) { return NGX_DECLINED; }
+    path = ngx_pnalloc(r->pool, value->len + 1);
+    if (path == NULL) { return NGX_DECLINED; }
+    ngx_cpystrn(path, value->data, value->len + 1);
+    root = ngx_open_file(path, NGX_SA_ROOT_MODE, NGX_FILE_OPEN, 0);
+    if (root == NGX_INVALID_FILE) { return NGX_DECLINED; }
+    rc = ngx_fd_info(root, &fi) != NGX_FILE_ERROR && ngx_is_dir(&fi)
+         ? ngx_sa_owner(root, &owner) : NGX_DECLINED;
+    ngx_close_file(root);
+    if (rc != NGX_OK) { return NGX_DECLINED; }
+    cache = ngx_http_get_module_main_conf(r, ngx_http_symlink_access_module);
+    user = ngx_sa_cached_user(cache, r->pool, &owner);
+    if (user == NULL) { return NGX_DECLINED; }
+    rc = ngx_sa_permissions(r->pool, fd, user);
+    return rc >= 0 && (rc & 4) ? NGX_OK : NGX_DECLINED;
+}
+
+ngx_int_t
+ngx_http_symlink_open_cached_file(ngx_http_request_t *r, ngx_open_file_cache_t *cache,
+    ngx_str_t *name, ngx_open_file_info_t *of, ngx_pool_t *pool)
+{
+    ngx_flag_t linked = 0, test = of->test_only;
+    ngx_int_t rc;
+    if (!ngx_http_symlink_access_enabled(r) || of->log) {
+        return ngx_open_cached_file(cache, name, of, pool);
+    }
+    of->test_only = 0; /* Authorize the same descriptor even for try_files probes. */
+    rc = ngx_sa_open(name, of, pool, &linked);
+    of->test_only = test;
+    if (rc != NGX_OK) { return rc; }
+    if (linked && !of->is_dir && (!of->is_file || ngx_sa_check(r, of->fd) != NGX_OK)) {
+        of->err = NGX_EACCES;
+        of->failed = "symlink_access";
+        rc = NGX_ERROR;
+    }
+    if ((test || rc != NGX_OK) && of->fd != NGX_INVALID_FILE) {
+        ngx_pool_run_cleanup_file(pool, of->fd);
+        of->fd = NGX_INVALID_FILE;
+    }
+    return rc;
+}
