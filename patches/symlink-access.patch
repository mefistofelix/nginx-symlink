diff --git a/src/http/modules/ngx_http_symlink_access_module.c b/src/http/modules/ngx_http_symlink_access_module.c
new file mode 100644
index 0000000..5c5200c
--- /dev/null
+++ b/src/http/modules/ngx_http_symlink_access_module.c
@@ -0,0 +1,249 @@
+/* Symlink target access policy. SPDX-License-Identifier: BSD-2-Clause */
+#include <ngx_config.h>
+#include <ngx_core.h>
+#include <ngx_http.h>
+#include <ngx_symlink_access.h>
+
+typedef struct {
+    ngx_uint_t       max;
+    time_t           valid;
+    time_t           negative_valid;
+    ngx_flag_t       configured;
+    ngx_sa_cache_t  *cache;
+} ngx_http_sa_main_conf_t;
+
+typedef struct {
+    ngx_uint_t                 enabled;
+    ngx_http_complex_value_t  *root;
+} ngx_http_sa_loc_conf_t;
+
+static void *ngx_http_sa_create_main(ngx_conf_t *cf);
+static char *ngx_http_sa_init_main(ngx_conf_t *cf, void *conf);
+static void *ngx_http_sa_create_loc(ngx_conf_t *cf);
+static char *ngx_http_sa_merge_loc(ngx_conf_t *cf, void *parent, void *child);
+static char *ngx_http_sa_cache(ngx_conf_t *cf, ngx_command_t *cmd, void *conf);
+
+static ngx_conf_enum_t ngx_http_sa_modes[] = {
+    { ngx_string("off"), 0 },
+    { ngx_string("root_owner"), 1 },
+    { ngx_null_string, 0 }
+};
+
+static ngx_command_t ngx_http_sa_commands[] = {
+    { ngx_string("symlink_access"),
+      NGX_HTTP_MAIN_CONF|NGX_HTTP_SRV_CONF|NGX_HTTP_LOC_CONF|NGX_CONF_TAKE1,
+      ngx_conf_set_enum_slot, NGX_HTTP_LOC_CONF_OFFSET,
+      offsetof(ngx_http_sa_loc_conf_t, enabled), ngx_http_sa_modes },
+    { ngx_string("symlink_access_root"),
+      NGX_HTTP_MAIN_CONF|NGX_HTTP_SRV_CONF|NGX_HTTP_LOC_CONF|NGX_CONF_TAKE1,
+      ngx_http_set_complex_value_slot, NGX_HTTP_LOC_CONF_OFFSET,
+      offsetof(ngx_http_sa_loc_conf_t, root), NULL },
+    { ngx_string("symlink_access_cache"), NGX_HTTP_MAIN_CONF|NGX_CONF_1MORE,
+      ngx_http_sa_cache, NGX_HTTP_MAIN_CONF_OFFSET, 0, NULL },
+    ngx_null_command
+};
+
+static ngx_http_module_t ngx_http_sa_ctx = {
+    NULL, NULL,
+    ngx_http_sa_create_main, ngx_http_sa_init_main,
+    NULL, NULL,
+    ngx_http_sa_create_loc, ngx_http_sa_merge_loc
+};
+
+ngx_module_t ngx_http_symlink_access_module = {
+    NGX_MODULE_V1, &ngx_http_sa_ctx, ngx_http_sa_commands, NGX_HTTP_MODULE,
+    NULL, NULL, NULL, NULL, NULL, NULL, NULL, NGX_MODULE_V1_PADDING
+};
+
+static void *
+ngx_http_sa_create_main(ngx_conf_t *cf)
+{
+    ngx_http_sa_main_conf_t *conf;
+    conf = ngx_pcalloc(cf->pool, sizeof(*conf));
+    if (conf == NULL) { return NULL; }
+    conf->max = 1024;
+    conf->valid = 30;
+    conf->negative_valid = 1;
+    return conf;
+}
+
+static char *
+ngx_http_sa_init_main(ngx_conf_t *cf, void *data)
+{
+    ngx_http_sa_main_conf_t *conf = data;
+    conf->cache = ngx_sa_cache_create(cf->pool, conf->max, conf->valid,
+                                     conf->negative_valid);
+    return conf->cache ? NGX_CONF_OK : NGX_CONF_ERROR;
+}
+
+static void *
+ngx_http_sa_create_loc(ngx_conf_t *cf)
+{
+    ngx_http_sa_loc_conf_t *conf;
+    conf = ngx_pcalloc(cf->pool, sizeof(*conf));
+    if (conf == NULL) { return NULL; }
+    conf->enabled = NGX_CONF_UNSET_UINT;
+    conf->root = NGX_CONF_UNSET_PTR;
+    return conf;
+}
+
+static char *
+ngx_http_sa_merge_loc(ngx_conf_t *cf, void *parent, void *child)
+{
+    ngx_http_sa_loc_conf_t *prev = parent, *conf = child;
+    ngx_http_compile_complex_value_t ccv;
+    ngx_str_t root = ngx_string("$document_root");
+
+    ngx_conf_merge_uint_value(conf->enabled, prev->enabled, 0);
+    ngx_conf_merge_ptr_value(conf->root, prev->root, NULL);
+    if (conf->root == NULL) {
+        conf->root = ngx_pcalloc(cf->pool, sizeof(ngx_http_complex_value_t));
+        if (conf->root == NULL) { return NGX_CONF_ERROR; }
+        ngx_memzero(&ccv, sizeof(ccv));
+        ccv.cf = cf;
+        ccv.value = &root;
+        ccv.complex_value = conf->root;
+        if (ngx_http_compile_complex_value(&ccv) != NGX_OK) {
+            return NGX_CONF_ERROR;
+        }
+    }
+    return NGX_CONF_OK;
+}
+
+static char *
+ngx_http_sa_cache(ngx_conf_t *cf, ngx_command_t *cmd, void *data)
+{
+    ngx_http_sa_main_conf_t *conf = data;
+    ngx_str_t *v, s;
+    ngx_uint_t i, seen;
+    ngx_int_t n;
+    time_t t;
+
+    if (conf->configured) { return "is duplicate"; }
+    conf->configured = 1;
+    v = cf->args->elts;
+    if (cf->args->nelts == 2 && ngx_strcmp(v[1].data, "off") == 0) {
+        conf->max = 0;
+        return NGX_CONF_OK;
+    }
+    seen = 0;
+    for (i = 1; i < cf->args->nelts; i++) {
+        if (v[i].len > 4 && ngx_strncmp(v[i].data, "max=", 4) == 0) {
+            if (seen & 1) { return "has duplicate max"; }
+            seen |= 1;
+            n = ngx_atoi(v[i].data + 4, v[i].len - 4);
+            if (n < 1 || n > 65536) { return "requires max between 1 and 65536"; }
+            conf->max = (ngx_uint_t) n;
+        } else if (v[i].len > 6 && ngx_strncmp(v[i].data, "valid=", 6) == 0) {
+            if (seen & 2) { return "has duplicate valid"; }
+            seen |= 2;
+            s.data = v[i].data + 6; s.len = v[i].len - 6;
+            t = ngx_parse_time(&s, 1);
+            if (t == (time_t) NGX_ERROR) { return "has invalid valid"; }
+            conf->valid = t;
+        } else if (v[i].len > 15
+                   && ngx_strncmp(v[i].data, "negative_valid=", 15) == 0)
+        {
+            if (seen & 4) { return "has duplicate negative_valid"; }
+            seen |= 4;
+            s.data = v[i].data + 15; s.len = v[i].len - 15;
+            t = ngx_parse_time(&s, 1);
+            if (t == (time_t) NGX_ERROR) { return "has invalid negative_valid"; }
+            conf->negative_valid = t;
+        } else { return "has an unknown parameter"; }
+    }
+    return NGX_CONF_OK;
+}
+
+ngx_flag_t
+ngx_http_symlink_access_enabled(ngx_http_request_t *r)
+{
+    ngx_http_sa_loc_conf_t *conf;
+    conf = ngx_http_get_module_loc_conf(r, ngx_http_symlink_access_module);
+    return conf->enabled;
+}
+
+static ngx_int_t
+ngx_http_sa_prepare(ngx_http_request_t *r, ngx_symlink_access_t *ctx)
+{
+    ngx_http_sa_loc_conf_t  *conf;
+    ngx_http_sa_main_conf_t *main;
+    ngx_str_t               root, prefix;
+
+    conf = ngx_http_get_module_loc_conf(r, ngx_http_symlink_access_module);
+    main = ngx_http_get_module_main_conf(r, ngx_http_symlink_access_module);
+    ctx->pool = r->pool;
+    ctx->cache = main->cache;
+    if (ngx_http_complex_value(r, conf->root, &root) != NGX_OK
+        || root.len == 0 || ngx_strlchr(root.data, root.data + root.len, '\0'))
+    {
+        return NGX_OK; /* Invalid identity: deny if a symlink is encountered. */
+    }
+    ctx->root.data = ngx_pnalloc(r->pool, root.len + 1);
+    if (ctx->root.data == NULL) { return NGX_ERROR; }
+    ngx_memcpy(ctx->root.data, root.data, root.len);
+    ctx->root.data[root.len] = '\0';
+    ctx->root.len = root.len;
+    prefix = ngx_cycle->prefix;
+    if (ngx_get_full_name(r->pool, &prefix, &ctx->root) != NGX_OK) {
+        return NGX_ERROR;
+    }
+    return NGX_OK;
+}
+
+/* Private context: nothing is added to upstream structs or retained globally. */
+ngx_int_t
+ngx_http_symlink_open_cached_file(ngx_http_request_t *r,
+    ngx_open_file_cache_t *cache, ngx_str_t *name, ngx_open_file_info_t *of,
+    ngx_pool_t *pool)
+{
+    ngx_symlink_access_t     ctx;
+    ngx_file_info_t          fi;
+    ngx_fd_t                 fd;
+    ngx_pool_cleanup_t      *cln;
+    ngx_pool_cleanup_file_t *file;
+
+    if (!ngx_http_symlink_access_enabled(r) || of->log) {
+        return ngx_open_cached_file(cache, name, of, pool);
+    }
+    ngx_memzero(&ctx, sizeof(ctx));
+    of->fd = NGX_INVALID_FILE;
+    of->err = 0;
+    of->failed = "symlink_access";
+    if (ngx_http_sa_prepare(r, &ctx) != NGX_OK) { return NGX_ERROR; }
+    fd = ngx_symlink_access_open(name, of, &ctx,
+                                NGX_FILE_RDONLY|NGX_FILE_NONBLOCK,
+                                NGX_FILE_OPEN, 0, pool->log);
+    if (fd == NGX_INVALID_FILE) { return NGX_ERROR; }
+    if (ngx_fd_info(fd, &fi) == NGX_FILE_ERROR) {
+        of->err = ngx_errno;
+        ngx_close_file(fd);
+        return NGX_ERROR;
+    }
+    of->uniq = ngx_file_uniq(&fi);
+    of->mtime = ngx_file_mtime(&fi);
+    of->size = ngx_file_size(&fi);
+    of->fs_size = ngx_file_fs_size(&fi);
+    of->is_dir = ngx_is_dir(&fi);
+    of->is_file = ngx_is_file(&fi);
+    of->is_link = ngx_is_link(&fi);
+    of->is_exec = ngx_is_exec(&fi);
+    of->is_directio = 0;
+    if (of->test_only || of->is_dir) {
+        ngx_close_file(fd);
+        return NGX_OK;
+    }
+    cln = ngx_pool_cleanup_add(pool, sizeof(ngx_pool_cleanup_file_t));
+    if (cln == NULL) { ngx_close_file(fd); return NGX_ERROR; }
+    cln->handler = ngx_pool_cleanup_file;
+    file = cln->data;
+    file->fd = fd; file->name = name->data; file->log = pool->log;
+    of->fd = fd;
+    if (of->read_ahead && of->size > 128 * 1024) {
+        (void) ngx_read_ahead(fd, of->read_ahead);
+    }
+    if (of->directio <= of->size && ngx_directio_on(fd) != NGX_FILE_ERROR) {
+        of->is_directio = 1;
+    }
+    return NGX_OK;
+}
